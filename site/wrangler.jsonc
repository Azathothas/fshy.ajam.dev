// fshy: the static wiki in ./dist plus a Worker for the read-only API and the MCP endpoint.
// ./dist is written by `python publish/build.py --site site/dist`; nothing here is a secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fshy",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": true,
  // a fork edits these two lines and the FSHY_ORIGIN of its build (site/README.md, section Fork)
  "routes": [{ "pattern": "fshy.ajam.dev", "custom_domain": true }],
  "vars": { "FSHY_HOST": "fshy.ajam.dev" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // the Worker answers every path of /api/v1/ (the routes, the route list and a JSON 404), except the static files
    // that the build writes there; site/README.md, section "What the Worker serves"
    "run_worker_first": [
      "/api/v1",
      "/api/v1/*",
      "!/api/v1/entity/*",
      "!/api/v1/names.json",
      "!/api/v1/needs.json",
      "!/api/v1/vocab.json",
      "!/api/v1/schema.sql",
      "!/api/v1/help.txt",
      "/mcp",
      "/r/*",
      "/data/fshy-public.sqlite.gz"
    ]
  },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  // two bindings with one namespace_id share their counters across the Workers of an account, so these are not the
  // example values of the documentation (1001, 1002)
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "47201", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SQL", "namespace_id": "47202", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // the backstop of the SQL route: the platform stops a request after 2,500 ms of CPU (error 1102). It is 3.5 times
  // the costliest request that the Worker accepts (718 ms); site/README.md has the measurements
  "limits": { "cpu_ms": 2500 }
}
