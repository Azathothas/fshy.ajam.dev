#!/bin/sh
# Refuses a commit message that credits a tool.  The corpus records what changed
# and who decided it; the instrument that typed it is not part of the record.
#
# Enable once per clone:  git config core.hooksPath .githooks

msg="$1"

if grep -qiE '^(co-authored-by|generated-with|generated-by|signed-off-by:.*(claude|gpt|copilot|kimi|gemini|codex|agent))' "$msg"; then
    echo "commit-msg: refuses a trailer that credits a tool" >&2
    exit 1
fi

if grep -qiE '(generated (with|by)|written (with|by)|powered by) (claude|chatgpt|gpt|copilot|kimi|gemini|codex|an? (ai|llm))' "$msg"; then
    echo "commit-msg: refuses a body that credits a tool" >&2
    exit 1
fi

first=$(grep -vE '^\s*(#|$)' "$msg" | head -1)
if [ ${#first} -gt 100 ]; then
    echo "commit-msg: the subject is ${#first} characters; keep it under 101" >&2
    exit 1
fi

if [ -z "$first" ]; then
    echo "commit-msg: the message has no subject" >&2
    exit 1
fi

case "$first" in
    *. ) echo "commit-msg: the subject ends in a full stop; drop it" >&2; exit 1 ;;
esac

exit 0
